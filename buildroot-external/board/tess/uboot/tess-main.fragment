# Main image only (the flasher boots over FEL, where an environment in
# MMC has no valid location and U-Boot would hang): environment on the
# SD NAND and the A/B boot of board/sunxi/tess.env
# (patches/uboot/0001-board-sunxi-add-the-Tess-environment.patch)

# Two redundant copies of 64 KiB between U-Boot (8 KiB - 1 MiB) and the
# first partition (4 MiB); /etc/fw_env.config must match
# CONFIG_ENV_IS_NOWHERE is not set
CONFIG_ENV_IS_IN_MMC=y
CONFIG_ENV_MMC_DEVICE_INDEX=0
CONFIG_ENV_REDUNDANT=y
CONFIG_ENV_OFFSET=0x100000
CONFIG_ENV_OFFSET_REDUND=0x110000
CONFIG_ENV_SIZE=0x10000

CONFIG_ENV_SOURCE_FILE="tess"
CONFIG_BOOTCOMMAND="env default -f tess_boot; run tess_boot"

# Device tree overlays (the DSI display, extlinux.conf "fdtoverlays")
CONFIG_OF_LIBFDT_OVERLAY=y
