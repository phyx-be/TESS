# Main image only, on top of tess-common.fragment (the flasher boots over
# FEL, where an environment in MMC has no valid location and U-Boot would
# hang): environment on the SD NAND. The A/B boot logic is the default
# environment tess-main.env (BR2_TARGET_UBOOT_DEFAULT_ENV_FILE in
# configs/tess_defconfig).

# Two redundant copies of 64 KiB between U-Boot (8 KiB - 1 MiB) and the
# first partition (4 MiB); /etc/fw_env.config must match
# CONFIG_ENV_IS_NOWHERE is not set
CONFIG_ENV_IS_IN_MMC=y
CONFIG_ENV_MMC_DEVICE_INDEX=0
CONFIG_ENV_REDUNDANT=y
CONFIG_ENV_OFFSET=0x100000
CONFIG_ENV_OFFSET_REDUND=0x110000
CONFIG_ENV_SIZE=0x10000
