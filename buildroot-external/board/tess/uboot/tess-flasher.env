# U-Boot default environment of the Tess flasher image
# (BR2_TARGET_UBOOT_DEFAULT_ENV_FILE in configs/tess_flasher_defconfig).
# It replaces the whole built-in default environment, so the memory layout
# of include/configs/sunxi-common.h is repeated here. Lines ending in a
# backslash continue on the next line (keep a space before the backslash).
#
# U-Boot is started over USB (FEL) by sunxi-fel, in one of two ways:
#
# - flash.sh uploads the flasher kernel, device tree, boot script and root
#   filesystem along with it. sunxi-fel passes the boot script's
#   address to U-Boot, which puts it in fel_scriptaddr, and bootcmd runs
#   the script (uboot/boot.cmd): the flasher Linux boots, to flash the
#   ESP32-C3.
# - flash-sd.sh uploads U-Boot alone. There is no fel_scriptaddr, so
#   bootcmd starts USB DFU: dfu-util on the host writes an image to the
#   SD NAND ("sdcard", the whole 480 MiB device as a raw entity), and
#   when it detaches (dfu-util -R) U-Boot resets the board, which boots
#   the new image.

bootdelay=2
bootcmd=if test -n "${fel_scriptaddr}"; then \
		echo "Tess: boot script at ${fel_scriptaddr}, booting the flasher"; \
		source ${fel_scriptaddr}; \
	else \
		echo "Tess: no boot script, USB DFU to write the SD NAND (dfu-util -a sdcard)"; \
		dfu 0 mmc 0; \
		reset; \
	fi
dfu_alt_info=sdcard raw 0 0xF0000
stdin=serial
stdout=serial
stderr=serial

# Memory layout (sunxi-common.h): 128 MiB DRAM at 0x40000000
bootm_size=0x2e00000
loadaddr=0x42000000
kernel_addr_r=0x41000000
fdt_addr_r=0x41800000
scriptaddr=0x41900000
pxefile_addr_r=0x41A00000
fdtoverlay_addr_r=0x41B00000
ramdisk_addr_r=0x41C00000
fdtfile=sun8i-t113s-tess.dtb
