# U-Boot default environment of the Tess main image
# (BR2_TARGET_UBOOT_DEFAULT_ENV_FILE in configs/tess_defconfig).
#
# This file replaces the whole built-in default environment, so the
# memory layout of include/configs/sunxi-common.h (sysboot/extlinux load
# addresses) is repeated here. Lines ending in a backslash continue on
# the next line, whose leading whitespace is dropped: keep a space before
# the backslash.
#
# A/B boot of the root filesystem, for RAUC: slot A is mmc 0:1, slot B
# is mmc 0:2. BOOT_ORDER lists the slots to try, BOOT_x_LEFT how many
# boot attempts each slot has left. Every attempt decrements the counter
# and saves the environment; Linux resets it with "rauc status
# mark-good" once it is up. A slot without attempts left is skipped, so a
# slot that fails three times in a row falls back to the other one. RAUC
# changes BOOT_ORDER and the counters with fw_setenv when it installs an
# update.
#
# bootcmd reloads tess_boot from this default environment before running
# it, so a saved environment cannot keep an old version.

bootdelay=2
bootcmd=env default -f tess_boot; run tess_boot
stdin=serial
stdout=serial
stderr=serial

# Memory layout (sunxi-common.h): 128 MiB DRAM at 0x40000000
bootm_size=0x2e00000
loadaddr=0x42000000
kernel_addr_r=0x41000000
fdt_addr_r=0x41800000
scriptaddr=0x41900000
pxefile_addr_r=0x41A00000
fdtoverlay_addr_r=0x41B00000
ramdisk_addr_r=0x41C00000
fdtfile=sun8i-t113s-tess.dtb

BOOT_ORDER=A B
BOOT_A_LEFT=3
BOOT_B_LEFT=3

tess_boot=setenv tess_part; \
	setenv tess_slot; \
	for BOOT_SLOT in "${BOOT_ORDER}"; do \
		if test -z "${tess_part}" && test "x${BOOT_SLOT}" = "xA" && \
		   test ${BOOT_A_LEFT} -gt 0; then \
			setexpr BOOT_A_LEFT ${BOOT_A_LEFT} - 1; \
			setenv tess_part 1; \
			setenv tess_slot A; \
		fi; \
		if test -z "${tess_part}" && test "x${BOOT_SLOT}" = "xB" && \
		   test ${BOOT_B_LEFT} -gt 0; then \
			setexpr BOOT_B_LEFT ${BOOT_B_LEFT} - 1; \
			setenv tess_part 2; \
			setenv tess_slot B; \
		fi; \
	done; \
	if test -n "${tess_part}"; then \
		echo "Tess: booting slot ${tess_slot} (mmc 0:${tess_part})," \
		     "attempts left: A ${BOOT_A_LEFT}, B ${BOOT_B_LEFT}"; \
		saveenv; \
		sysboot mmc 0:${tess_part} any ${scriptaddr} \
			/boot/extlinux/extlinux.conf; \
		echo "Tess: slot ${tess_slot} does not boot"; \
		reset; \
	fi; \
	echo "Tess: no slot left to boot, resetting the boot counters"; \
	setenv BOOT_A_LEFT 3; \
	setenv BOOT_B_LEFT 3; \
	saveenv; \
	reset
