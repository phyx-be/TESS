#!/bin/sh
#
# Mount the data partition read-write on /data and bind-mount the
# persistent directories of the read-only root filesystem (DATA_BINDS in
# /etc/default/datafs) from /data/rootfs.
#
# The image (sdcard.img) does not contain the data partition, so writing
# it leaves the data alone. When the partition table has no data
# partition, it is added from the first 4 MiB boundary after the previous
# partition (root filesystem slot B) to the end of the disk: the whole
# SD NAND, whatever its size, and the same place every time, so a data
# filesystem from before a reinstall is found again; the system then
# reboots once to use it. A data partition
# without a filesystem gets a new one. One that cannot be repaired or
# mounted is left alone: /data is then a tmpfs, so the system still
# boots, but nothing persists.

DATA_DISK=/dev/mmcblk0
DATA_PART=3
DATA_DIR=/data
DATA_BINDS=""

# shellcheck source=/dev/null
[ -r /etc/default/datafs ] && . /etc/default/datafs

DATA_DEV=${DATA_DISK}p${DATA_PART}
ALIGN=8192	# 4 MiB in 512 byte sectors

log() {
	echo "datafs: $*"
	logger -t datafs "$*" 2>/dev/null
}

is_ext4() {
	tune2fs -l "$1" > /dev/null 2>&1
}

# Add the data partition to the partition table (busybox fdisk). The root
# filesystem is mounted, so the kernel cannot re-read the partition table:
# reboot, once, to use the new partition. Nothing is mounted read-write
# yet.
create_partition() {
	disk=${DATA_DISK##*/}
	prev=/sys/block/${disk}/${disk}p$((DATA_PART - 1))
	if [ ! -r "${prev}/start" ]; then
		log "${prev##*/} not found, cannot place the data partition"
		return 1
	fi
	start=$(( ($(cat "${prev}/start") + $(cat "${prev}/size") + ALIGN - 1) / ALIGN * ALIGN ))

	log "no data partition, creating ${DATA_DEV} from sector ${start} to the end of ${DATA_DISK}"
	# new primary partition DATA_PART, from start to the default end (the
	# end of the disk), type Linux; fdisk's re-read of the table fails
	printf 'n\np\n%s\n%s\n\nw\n' "${DATA_PART}" "${start}" |
		fdisk -u "${DATA_DISK}" > /dev/null 2>&1
	if ! fdisk -l -u "${DATA_DISK}" | grep -q "^${DATA_DEV} "; then
		log "fdisk could not add ${DATA_DEV}"
		return 1
	fi

	log "rebooting to use ${DATA_DEV}"
	echo "Created ${DATA_DEV}, rebooting"
	sync
	reboot -f
}

mount_data() {
	if [ ! -b "${DATA_DEV}" ] && ! create_partition; then
		log "cannot create ${DATA_DEV}"
		return 1
	fi

	# Repair: -p fixes what is safe, exit code 4 and up needs -y. With a
	# damaged primary superblock e2fsck uses a backup.
	e2fsck -p "${DATA_DEV}" > /dev/null 2>&1
	if [ $? -ge 4 ]; then
		e2fsck -y "${DATA_DEV}" > /dev/null 2>&1
	fi

	if ! is_ext4 "${DATA_DEV}"; then
		log "no filesystem on ${DATA_DEV}, creating one"
		mkfs.ext4 -q -F -L data "${DATA_DEV}" || return 1
	fi

	mount -t ext4 -o noatime "${DATA_DEV}" "${DATA_DIR}"
}

# Copy the root filesystem entries of $1 that are missing in $2
seed() {
	for e in "$1"/* "$1"/.[!.]*; do
		[ -e "${e}" ] || [ -L "${e}" ] || continue
		[ -e "$2/${e##*/}" ] || [ -L "$2/${e##*/}" ] || cp -a "${e}" "$2/"
	done
}

start() {
	printf "Mounting the data partition: "
	if mount_data; then
		echo "OK"
	else
		echo "FAIL, using a tmpfs"
		log "cannot mount ${DATA_DEV}, nothing persists until it is fixed"
		mount -t tmpfs -o mode=0755 data "${DATA_DIR}"
	fi

	for d in ${DATA_BINDS}; do
		src="${DATA_DIR}/rootfs${d}"
		mkdir -p "${src}" "${d}"
		seed "${d}" "${src}"
		mount --bind "${src}" "${d}"
	done
}

stop() {
	for d in ${DATA_BINDS}; do
		umount "${d}" 2>/dev/null
	done
	umount "${DATA_DIR}" 2>/dev/null
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart|reload)
		;;
	*)
		echo "Usage: $0 {start|stop|restart|reload}"
		exit 1
esac
