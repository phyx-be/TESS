From 8e1ecc7d502ce11185cb02b01822b03b184bfbd9 Mon Sep 17 00:00:00 2001
From: Bert Outtier <outtierbert@gmail.com>
Date: Wed, 14 Oct 2026 11:51:47 +0200
Subject: [PATCH] board: sunxi: add the Tess environment

Default environment for the Tess board (phyxbe), selected with
CONFIG_ENV_SOURCE_FILE="tess": A/B boot of the root filesystem for
RAUC, with the boot counters BOOT_ORDER, BOOT_A_LEFT and BOOT_B_LEFT.

Upstream-Status: Inappropriate [board specific]
---
 board/sunxi/tess.env | 50 ++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 50 insertions(+)
 create mode 100644 board/sunxi/tess.env

diff --git a/board/sunxi/tess.env b/board/sunxi/tess.env
new file mode 100644
index 0000000..f88d921
--- /dev/null
+++ b/board/sunxi/tess.env
@@ -0,0 +1,50 @@
+/*
+ * Tess (phyxbe): A/B boot of the root filesystem, for RAUC
+ *
+ * Root filesystem slot A is mmc 0:1, slot B is mmc 0:2. BOOT_ORDER lists
+ * the slots to try, BOOT_x_LEFT how many boot attempts each slot has
+ * left. Every attempt decrements the counter and saves the environment;
+ * Linux resets it with "rauc status mark-good" once it is up. A slot
+ * without attempts left is skipped, so a slot that fails three times in
+ * a row falls back to the other one. RAUC changes BOOT_ORDER and the
+ * counters with fw_setenv when it installs an update.
+ *
+ * bootcmd reloads tess_boot from this default environment before
+ * running it, so a saved environment cannot keep an old version.
+ */
+
+BOOT_ORDER=A B
+BOOT_A_LEFT=3
+BOOT_B_LEFT=3
+
+tess_boot=
+	setenv tess_part;
+	setenv tess_slot;
+	for BOOT_SLOT in "${BOOT_ORDER}"; do
+		if test -z "${tess_part}" && test "x${BOOT_SLOT}" = "xA" &&
+		   test ${BOOT_A_LEFT} -gt 0; then
+			setexpr BOOT_A_LEFT ${BOOT_A_LEFT} - 1;
+			setenv tess_part 1;
+			setenv tess_slot A;
+		fi;
+		if test -z "${tess_part}" && test "x${BOOT_SLOT}" = "xB" &&
+		   test ${BOOT_B_LEFT} -gt 0; then
+			setexpr BOOT_B_LEFT ${BOOT_B_LEFT} - 1;
+			setenv tess_part 2;
+			setenv tess_slot B;
+		fi;
+	done;
+	if test -n "${tess_part}"; then
+		echo "Tess: booting slot ${tess_slot} (mmc 0:${tess_part}),"
+		     "attempts left: A ${BOOT_A_LEFT}, B ${BOOT_B_LEFT}";
+		saveenv;
+		sysboot mmc 0:${tess_part} any ${scriptaddr}
+			/boot/extlinux/extlinux.conf;
+		echo "Tess: slot ${tess_slot} does not boot";
+		reset;
+	fi;
+	echo "Tess: no slot left to boot, resetting the boot counters";
+	setenv BOOT_A_LEFT 3;
+	setenv BOOT_B_LEFT 3;
+	saveenv;
+	reset
-- 
